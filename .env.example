PORT=3000
BASE_PATH=/

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
# Dedicated database for this portal (self-contained: rp_* tables + copies of the
# shared masters tbl_employee / tbl_financial_year / tbl_leaders / designations).
DB_NAME=rp_db

# Employee codes allowed to reach the assign pages and act as PSP Approver
ADMIN_CODES=MM008
# Employee codes for the LDP Admin (final approval of Sanghrakshak / Seva Sangh profiles).
# Leave unset to default to ADMIN_CODES.
# LDP_ADMIN_CODES=

# SS/SS1 belong to LDP, not PSP
EXCLUDED_SANGHS=SS,SS1

SESSION_SECRET=change-me-in-production

# Read-only API for Zoho Recruit. Empty = the API is off.
API_TOKEN=
# The address Zoho reaches the portal on, used when building links (no trailing slash).
PUBLIC_URL=http://localhost:3000
