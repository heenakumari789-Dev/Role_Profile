<%
  const trim2 = (v) => String(Math.round(Number(v) * 100) / 100);
  const fmt = (v) => fmtDateTime(v) || '—';
  // Fold the flat rows back into attributes, the way the details tab shows them.
  const groups = [];
  details.forEach(d => {
    let last = groups[groups.length - 1];
    if (!last || last.no !== d.attribute_no) {
      last = { no: d.attribute_no, name: d.attribute, weight: d.attribute_weight, skills: [] };
      groups.push(last);
    }
    last.skills.push(d);
  });
%>
<a class="rp-back-link" href="/role-profiles/<%= profile.id %>?tab=versions"><i class="mdi mdi-arrow-left"></i> All versions</a>

<div class="rp-card">
    <div class="rp-card-header">
        <div class="rp-card-header-left">
            <div class="rp-card-header-icon"><i class="mdi mdi-source-branch"></i></div>
            <div>
                <div class="rp-card-title"><%= version.designation_name %></div>
                <div class="rp-card-subtitle">
                    <strong><%= version.sangh_name %></strong> · frozen on approval, <%= fmt(version.approved_at) %>
                </div>
            </div>
        </div>
        <div class="rp-header-actions">
            <a class="rp-pdf-btn" href="/role-profiles/<%= profile.id %>/versions/<%= version.id %>/pdf">
                <i class="mdi mdi-file-pdf-box"></i> Download PDF
            </a>
            <span class="rp-vchip<%= isLatest ? ' current' : '' %>">v<%= version.version_no %></span>
        </div>
    </div>
    <div class="rp-card-body">

        <div class="rp-frozen-note">
            <i class="mdi mdi-lock-outline"></i>
            <div>
                This is version <%= version.version_no %> exactly as it was approved — it cannot change.
                <% if (isLatest) { %>It is the version in force today.
                <% } else { %>The role profile has been revised since; this copy is kept so assessments
                written against it still read correctly.<% } %>
            </div>
        </div>

        <div class="rp-applies">
            <div><span class="l">Written by</span><span class="v"><%= personName(version.created_by, version.created_by_name) %></span></div>
            <% if (version.rp_approver_name) { %>
                <div><span class="l">RP Approver</span><span class="v"><%= version.rp_approver_name %></span></div>
            <% } %>
            <div><span class="l">In force from</span><span class="v"><%= version.effective_from_year || '—' %></span></div>
            <div><span class="l">Assessments</span><span class="v"><%= assessmentCount %></span></div>
        </div>

        <% if (years.length) { %>
            <div class="rp-year-strip">
                <span class="l">Financial years this version applies to:</span>
                <% years.forEach(y => { %>
                    <span class="rp-year-tag" title="<%= outcomeLabels[y.outcome] || y.outcome %><%= y.reviewed_by_name ? ' — ' + y.reviewed_by_name : '' %>"><%= y.financial_year %></span>
                <% }) %>
            </div>
        <% } %>

        <% if (changes) { %>
            <div class="rp-section" style="margin-top:18px">
                <h3><i class="mdi mdi-compare-horizontal"></i> What changed from version <%= version.version_no - 1 %></h3>
            </div>
            <ul class="rp-change-list">
                <% changes.forEach(c => { %><li><%= c %></li><% }) %>
            </ul>
        <% } %>

        <% if (String(version.mission || '').trim()) { %>
            <div class="rp-section"><h3><i class="mdi mdi-target"></i> Mission</h3></div>
            <div class="rp-mission"><%= version.mission %></div>
        <% } %>

        <% if (outcomes.length) { %>
            <div class="rp-section"><h3><i class="mdi mdi-flag-checkered"></i> Key Outcomes</h3></div>
            <ul class="rp-outcomes">
                <% outcomes.forEach(o => { %><li><%= o.outcome %></li><% }) %>
            </ul>
        <% } %>

        <div class="rp-section"><h3><i class="mdi mdi-format-list-checks"></i> Skills &amp; Attributes</h3></div>
        <% groups.forEach(g => { %>
            <div class="rp-attr">
                <div class="rp-attr-top">
                    <div><div class="rp-attr-name"><%= g.no %>. <%= g.name %></div></div>
                    <div><span class="rp-weight"><%= trim2(g.weight) %></span></div>
                </div>
                <% g.skills.forEach(sk => { %>
                    <div class="rp-skill">
                        <span><%= sk.tech_skill %></span>
                        <span class="rp-weight-sm"><%= trim2(sk.tech_weight) %></span>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    </div>
</div>
