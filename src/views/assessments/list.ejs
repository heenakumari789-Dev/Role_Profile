<%
  // An LDP row isn't "done" until the leader's final rating is in — self alone isn't enough,
  // and its final percentage is null until then, so it must not join the PSP average.
  const isDone = (r) => !!r.assessment && (r.program !== 'ldp' || !!r.assessment.final_submitted_at);
  const done = rows.filter(isDone);
  const pending = rows.filter(r => !isDone(r));
  const canAny = rows.some(r => r.can_assess);
  // A plain member sees one row per profile; everyone else one row per member.
  const countsMembers = canAny || me.isAdmin;
  const avgPct = done.length ? Math.round(done.reduce((s, r) => s + Number(r.assessment.percentage), 0) / done.length * 100) / 100 : null;
  const fmt = (v) => String(Math.round(Number(v) * 100) / 100);
  const band = (p) => p >= 75 ? 'high' : (p >= 50 ? 'mid' : 'low');
  const fmtDate = (v) => fmtDateTime(v) || '—';
%>
<div class="rp-card">
    <div class="rp-card-header">
        <div class="rp-card-header-left">
            <div class="rp-card-header-icon"><i class="mdi mdi-clipboard-check-outline"></i></div>
            <div>
                <div class="rp-card-title">Assessments</div>
                <div class="rp-card-subtitle">
                    <%= canAny ? 'Rate each member against the role profile that applies to them' : 'How you have been assessed against your role profile' %>
                    · financial year <strong><%= chosen %></strong><%= chosen === current ? ' (current)' : '' %>
                    <% if (canAny || me.isAdmin) { %>
                        <br><span style="font-size:0.78rem;color:var(--text-muted)">
                            <% if (me.isAdmin) { %>
                                As PSP Approver you can enter or correct <%= current %> and <%= previous %>. Older years are closed.
                            <% } else { %>
                                One assessment per member per year — once saved it is final, and the next is due in the following year.
                            <% } %>
                        </span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <div class="rp-card-body">

        <% if (narrowedTo) { %>
            <div class="rp-narrowed">
                <i class="mdi mdi-filter-outline"></i>
                <span>Showing only <strong><%= narrowedTo.name %></strong> · <%= narrowedTo.sangh %></span>
                <a class="rp-edit-btn" href="/assessments?fy=<%= encodeURIComponent(chosen) %>">
                    <i class="mdi mdi-close"></i> Show everyone
                </a>
            </div>
        <% } %>

        <form method="get" class="rp-year-bar">
            <% if (narrowedTo) { %><input type="hidden" name="profile" value="<%= narrowedTo.id %>"><% } %>
            <label for="fy"><i class="mdi mdi-calendar-range-outline"></i> Financial year</label>
            <select name="fy" id="fy" onchange="this.form.submit()">
                <% years.forEach(y => { %>
                    <option value="<%= y.year %>" <%= y.year === chosen ? 'selected' : '' %>>
                        <%= y.year %><%= y.is_current ? ' — current' : '' %>
                    </option>
                <% }) %>
            </select>
            <% if (chosen !== current) { %>
                <a class="rp-edit-btn" href="/assessments"><i class="mdi mdi-calendar-today"></i> Back to <%= current %></a>
            <% } %>
        </form>

        <% if (!rows.length) { %>
            <div class="rp-empty">
                <i class="mdi mdi-clipboard-text-outline"></i>
                <p>Nothing to assess for <%= chosen %>.<br>Assessments appear here once a role profile is approved and members hold it.</p>
            </div>
        <% } else { %>
            <div class="rp-summary">
                <div class="rp-summary-item"><div class="n"><%= rows.length %></div><div class="l"><%= countsMembers ? 'Members in scope' : 'Role profiles' %></div></div>
                <div class="rp-summary-item"><div class="n"><%= done.length %></div><div class="l">Assessed</div></div>
                <div class="rp-summary-item"><div class="n"><%= pending.length %></div><div class="l">Not yet assessed</div></div>
                <% if (avgPct !== null) { %>
                    <div class="rp-summary-item"><div class="n"><%= fmt(avgPct) %>%</div><div class="l">Average score</div></div>
                <% } %>
            </div>

            <div class="table-responsive">
                <table class="display" id="assessTable" style="width:100%">
                    <thead><tr><th>Member</th><th>Role profile</th><th>Score</th><th>Last assessed</th><th>Action</th></tr></thead>
                    <tbody>
                    <% rows.forEach(r => { const a = r.assessment; %>
                        <tr>
                            <td>
                                <span class="rp-name-cell">
                                    <span class="emp-name"><%= r.member_name %></span>
                                    <span class="sub" style="font-size:0.74rem;color:var(--text-muted)"><%= r.emp_code %><%= r.designation ? ' · ' + r.designation : '' %></span>
                                </span>
                            </td>
                            <td>
                                <span class="rp-name-cell">
                                    <span class="emp-name"><%= r.designation_name %></span>
                                    <span class="sub" style="font-size:0.74rem;color:var(--text-muted)"><%= r.sangh_name %></span>
                                </span>
                            </td>
                            <% if (r.program === 'ldp') { %>
                                <td data-order="<%= a && a.final_submitted_at ? a.percentage : -1 %>">
                                    <% if (!a) { %><span class="rp-pct-none">Not started</span>
                                    <% } else { %>
                                        <span style="font-size:0.73rem;color:var(--text-muted)">Self: <%= a.self_percentage !== null ? fmt(a.self_percentage) + '%' : '—' %></span><br>
                                        <% if (a.final_submitted_at) { %>
                                            <span class="rp-pct rp-pct-<%= band(Number(a.percentage)) %>">Final: <%= fmt(a.percentage) %>%</span>
                                        <% } else { %>
                                            <span class="rp-pct-none">Final: pending</span>
                                        <% } %>
                                    <% } %>
                                </td>
                                <td data-order="<%= a ? (a.final_submitted_at || a.self_submitted_at || '') : '' %>">
                                    <% if (!a) { %><span class="rp-pct-none">—</span>
                                    <% } else if (a.final_submitted_at) { %>
                                        <span style="font-size:0.76rem;color:var(--text-secondary)">
                                            <%= fmtDate(a.updated_at || a.final_submitted_at) %><br>
                                            <span style="color:var(--text-muted)">by <%= personName(a.assessed_by, a.assessed_by_name) %></span>
                                        </span>
                                    <% } else { %>
                                        <span style="font-size:0.76rem;color:var(--text-secondary)">
                                            <%= fmtDate(a.self_submitted_at) %><br>
                                            <span style="color:var(--text-muted)">self-rated</span>
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="rp-actions">
                                        <a class="rp-edit-btn" href="/role-profiles/<%= r.profile_id %>/assess/<%= encodeURIComponent(r.emp_code) %>?fy=<%= encodeURIComponent(chosen) %>">
                                            <% if (r.ldp_stage === 'self') { %><i class="mdi mdi-clipboard-edit-outline"></i> Self-rate
                                            <% } else if (r.ldp_stage === 'final') { %><i class="mdi mdi-clipboard-edit-outline"></i> Final rate
                                            <% } else { %><i class="mdi mdi-eye-outline"></i> View<% } %>
                                        </a>
                                    </div>
                                </td>
                            <% } else { %>
                                <td data-order="<%= a ? a.percentage : -1 %>">
                                    <% if (!a) { %><span class="rp-pct-none">Not assessed</span>
                                    <% } else { %>
                                        <span class="rp-pct rp-pct-<%= band(Number(a.percentage)) %>"><%= fmt(a.percentage) %>%</span>
                                        <span style="font-size:0.73rem;color:var(--text-muted)"><%= fmt(a.total_score) %>/<%= fmt(a.max_score) %></span>
                                        <% if (Number(a.gap_count) > 0) { %>
                                            <span class="rp-gap-flag" title="<%= a.gap_count %> training gap(s) noted"><i class="mdi mdi-school-outline"></i><%= a.gap_count %></span>
                                        <% } %>
                                    <% } %>
                                </td>
                                <td data-order="<%= a ? (a.updated_at || a.created_at) : '' %>">
                                    <% if (!a) { %><span class="rp-pct-none">—</span>
                                    <% } else { %>
                                        <span style="font-size:0.76rem;color:var(--text-secondary)">
                                            <%= fmtDate(a.updated_at || a.created_at) %><br>
                                            <span style="color:var(--text-muted)">by <%= personName(a.assessed_by, a.assessed_by_name) %></span>
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="rp-actions">
                                        <a class="rp-edit-btn" href="/role-profiles/<%= r.profile_id %>/assess/<%= encodeURIComponent(r.emp_code) %>?fy=<%= encodeURIComponent(chosen) %>">
                                            <% if (r.can_assess && !a) { %><i class="mdi mdi-clipboard-edit-outline"></i> Assess
                                            <% } else if (me.isAdmin && yearOpen && a) { %><i class="mdi mdi-pencil-outline"></i> Correct
                                            <% } else if (me.isAdmin && yearOpen) { %><i class="mdi mdi-clipboard-edit-outline"></i> Assess
                                            <% } else { %><i class="mdi mdi-eye-outline"></i> View<% } %>
                                        </a>
                                        <% if (a) { %>
                                            <a class="rp-edit-btn rp-edit-btn-pdf" title="Download this assessment as a PDF"
                                               href="/role-profiles/<%= r.profile_id %>/assess/<%= encodeURIComponent(r.emp_code) %>/pdf?fy=<%= encodeURIComponent(chosen) %>">
                                                <i class="mdi mdi-file-pdf-box"></i> PDF
                                            </a>
                                        <% } %>
                                    </div>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<% if (rows.length) { %>
<script>
$(function () {
    new DataTable('#assessTable', {
        pageLength: 25, order: [],
        columnDefs: [{ targets: [4], orderable: false, searchable: false }],
        language: {
            search: '<i class="mdi mdi-magnify"></i>', searchPlaceholder: 'Search assessments...',
            lengthMenu: 'Show _MENU_ entries', info: 'Showing _START_ to _END_ of _TOTAL_ entries',
            zeroRecords: 'Nothing matches your search',
            paginate: { first: '<i class="mdi mdi-chevron-double-left"></i>', last: '<i class="mdi mdi-chevron-double-right"></i>',
                        previous: '<i class="mdi mdi-chevron-left"></i>', next: '<i class="mdi mdi-chevron-right"></i>' }
        }
    });
});
</script>
<% } %>
